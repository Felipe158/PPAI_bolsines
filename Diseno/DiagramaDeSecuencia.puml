
@startuml

title Realización de CU28 - Registrar recepción de bolsín

autonumber

actor "Encargado de bolsines" as Responsable
boundary "pantalla:PantallaRecepcionBolsin" as Pantalla
control "gestor:GestorRecepcionBolsin" as Gestor

entity "actual:Sesion" as Sesion
entity "usuario:Usuario" as Usuario
entity "empleados:Empleado" as Empleados
entity "logueado:Empleado" as Empleado
entity "cmEmpleado:ComisionMedica" as CMEmpleado

entity "bolsin:Bolsin" as Bolsin
entity "seleccBolsin:Bolsin" as SeleccBolsin

entity "cmOrigenBolsin:ComisionMedica" as CMBolsin

entity ":CambioEstadoBolsin" as CEBolsin
entity "actual:CambioEstadoBolsin" as ActualCEBolsin
entity "RecibidoEnCMDestino:CambioEstadoBolsin" as RecibidoEnCMDestino


entity "estado:Estado" as Estado

entity "remito:Remito" as Remito
entity "detalle:DetalleDeRemito" as Detalle
entity "documentacion:Documentacion" as Doc
entity "tipoDocumento:TipoDocumento" as TipoDoc
entity "ceDocumentacion:CambioEstadoDocumentacion" as CED


create Pantalla
Responsable --> Pantalla : opcregistrarRecepcionBolsin()
Pantalla -> Pantalla : habilitarPantalla()

create Gestor
Pantalla --> Gestor : opcregistrarRecepcionBolsin()

activate Gestor

' Obtener empleado y comisión médica del usuario logueado
Gestor -> Gestor : getEmpleadoLogueado()
'Sesion --> Gestor : empleado

Gestor -> Sesion : getUsuario()
'Sesion --> Gestor : usuario

Gestor -> Empleados : *esTuUsuario(empleado)

'Usuario --> Gestor : empleado

Gestor -> Empleado : getCM() : CM

'Empleado --> Gestor : cm

Gestor -> CMEmpleado : getNombre()
'CM --> Gestor : nombreCM

Gestor --> Pantalla : mostrarCM(nombreCM)

' Buscar bolsines enviados a la CM
Gestor -> Gestor : buscarBolsinesEnviados()

loop Para todos los bolsines encontrados
    Gestor -> Bolsin : esTuCMDestino(cm)
    'Bolsin --> Gestor : resultado

    Gestor -> Bolsin : sosEnviado()
    Bolsin -> Bolsin : obtenerEstadoActual()
    Bolsin -> CEBolsin : sosActual()
    'CEBolsin --> Bolsin : cambioActual
    Bolsin -> ActualCEBolsin : sosEnviado()
    ActualCEBolsin -> Estado : esEnviado()
    'Estado --> Bolsin : resultado
    'Bolsin --> Gestor : resultado

    Gestor -> Bolsin : getCMOrigen()
    Gestor -> CMBolsin : getNombre()
    'Bolsin --> Gestor : cmOrigen

    Gestor -> Bolsin : getNumeroPrecinto()
    'Bolsin --> Gestor : numeroPrecinto
end

Gestor -> Pantalla : mostrarListadoBolsines()

Responsable -> Pantalla : tomarSeleccBolsin()
Pantalla -> Gestor : tomarSeleccBolsin()

' Buscar remitos y documentación del bolsín seleccionado
Gestor -> Gestor : buscarRemitosBolsin()
Gestor -> SeleccBolsin : obtenerInformacionRemito()
'Bolsin --> Gestor : remitos

loop Para todos los remitos del bolsín
    SeleccBolsin -> Remito : getNumero()
    'Remito --> Gestor : numeroRemito

    SeleccBolsin -> Remito : getDatosDocumentacion()
    'Remito --> Gestor : detalles

    loop Para todos los detalles del remito
        Remito -> Detalle : getDocumentacion()
        'Detalle --> Gestor : documentacion

        Detalle -> Doc : getAsunto()
        'Doc --> Gestor : asunto

        Detalle -> Doc : getTipoDocumento()
        'Doc --> Gestor : tipoDocumento

        Doc -> TipoDoc : getNombre()
        'TipoDoc --> Gestor : nombreTipoDocumento
    end
end

Gestor -> Pantalla : mostrarDatosRemitos()
Gestor -> Pantalla : mostrarOpcRecepcionBolsin()

Responsable -> Pantalla : tomarSeleccOpcionRecepcion()
Pantalla -> Gestor : tomarSeleccOpcionRecepcion()

Gestor -> Pantalla : solicitarConfirmacion()

Responsable -> Pantalla : tomarConfirmacion()
Pantalla -> Gestor : tomarConfirmacion()

' Validar que el bolsín corresponde a la recepción
Gestor -> Gestor : buscarEstadoRecibidoCMDestino()
loop Buscar estado Recibido en CM Destino
    Gestor -> Estado : esAmbitoBolsin()
    Gestor -> Estado : esRecibidoEnCMDestino()

end 

Gestor -> Gestor : getFechaActual()
'Sesion --> Gestor : fechaActual

Gestor -> Gestor : getEmpleadoLogueado()
'Sesion --> Gestor : empleado

Gestor -> Empleado : getDatosEmpleado()
'Empleado --> Gestor : datosEmpleado
Gestor -> Gestor : recibirBolsinCMDestino()

' Registrar recepción del bolsín
Gestor -> SeleccBolsin : recibirBolsin()

activate SeleccBolsin

SeleccBolsin -> SeleccBolsin : obtenerEstadoActual()
SeleccBolsin -> ActualCEBolsin : setFechaHoraFin()
SeleccBolsin -> SeleccBolsin : crearCambioDeEstado()

create RecibidoEnCMDestino
SeleccBolsin --> RecibidoEnCMDestino : new()
Gestor -> Gestor : buscarEstadoRecibidoYAceptado()
loop 
    Gestor -> Estado : esAmbitoRemito()
    Gestor -> Estado : esRecibidoYAceptado()

end

Gestor -> Gestor : RecibirYAceptarRemitos()
Gestor -> SeleccBolsin : RecibirYAceptarRemitos()


' Actualizar todos los remitos del bolsín
loop Para todos los remitos del bolsín
    SeleccBolsin -> Remito : recibirYAceptarRemito()

    activate Remito

    Remito -> Remito : setEstado(estadoRecibido)

    ' Actualizar la documentación de cada remito
    loop Para todos los detalles del remito
        Remito -> Detalle : actualizarEstadoDoc()
        Detalle -> Doc : aceptar()

        activate Doc

        Doc -> CED : sosActual()
        CED --> Doc : cambioEstadoActual

        Doc -> CED : setFechaHoraFin(fechaActual)

        create CED
        Doc -> CED : new()

        Doc -> Estado : buscarEstadoRecibidaYAceptada()
        Estado --> Doc : estadoRecibidaAceptada

        Doc -> CED : setEstado(estadoRecibidaAceptada)
        Doc -> CED : setResponsableCE(empleado)

        Doc --> Detalle : documentación actualizada

        deactivate Doc

        Detalle --> Remito : documentación actualizada
    end

    Remito --> Bolsin : remito actualizado

    deactivate Remito
end

deactivate Bolsin

' Caso de uso incluido
Gestor -> Gestor : llamarACUNotificarRecepcionBolsin()
Gestor -> Actor : <<include>> CU29 Notificar recepción Bolsín

Gestor --> Pantalla : mostrarNotificacionExito()
Gestor -> Gestor : finCU()

deactivate Gestor

@enduml
