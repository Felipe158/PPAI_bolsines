
@startuml
scale max 3000*3000
title Realización de CU28 - Registrar recepción de bolsín

autonumber

actor "Encargado de bolsines" as Responsable
boundary "pantalla\n:PantallaRecepcionBolsin" as Pantalla
control "gestor\n:GestorRecepcionBolsin" as Gestor

entity "actual\n:Sesion" as Sesion
entity ":Empleado" as Empleados #E8DAEF
entity "logueado\n:Empleado" as Empleado
entity "cmEmpleado\n:ComisionMedica" as CMEmpleado

entity ":Bolsin" as Bolsin #E8DAEF
entity "seleccBolsin:Bolsin" as SeleccBolsin

entity "cmOrigenBolsin\n:ComisionMedica" as CMBolsin

entity ":CambioEstadoBolsin" as CEBolsin
entity "actual\n:CambioEstadoBolsin" as ActualCEBolsin
entity "RecibidoEnCMDestino\n:CambioEstadoBolsin" as RecibidoEnCMDestino


entity "estado:Estado" as Estado

entity ":Remito" as Remito #E8DAEF
entity ":DetalleDeRemito" as Detalle #E8DAEF
entity ":Documentacion" as Doc #E8DAEF
entity ":TipoDocumento" as TipoDoc #E8DAEF
entity ":CambioEstadoDocumentacion" as CambEstDoc #E8DAEF
entity "RecibidaYAceptada\n:CambioEstadoDocumentacion" as NuevoCED
actor ":CU29" as CU29

create Pantalla
Responsable --> Pantalla : opcregistrarRecepcionBolsin() : void
Pantalla -> Pantalla : habilitarPantalla() : void

create Gestor
Pantalla --> Gestor : opcregistrarRecepcionBolsin() : void

activate Gestor

' Obtener empleado y comisión médica del usuario logueado
Gestor -> Gestor : getEmpleadoLogueado() : Empleado
'Sesion --> Gestor : empleado

Gestor -> Sesion : getUsuario() : Usuario
'Sesion --> Gestor : usuario

Gestor -> Empleados : *esTuUsuario(usuario:Usuario) : Boolean

'Usuario --> Gestor : empleado

Gestor -> Empleado : getCM() : ComisionMedica

'Empleado --> Gestor : cm

Gestor -> CMEmpleado : getNombre() : String
'CM --> Gestor : nombreCM

Gestor --> Pantalla : mostrarCM(nombreCM:String) : void

' Buscar bolsines enviados a la CM
Gestor -> Gestor : buscarBolsinesEnviados() : Bolsin[]

loop Para todos los bolsines
    Gestor -> Bolsin : esTuCMDestino(cm:ComisionMedica) : Boolean
    'Bolsin --> Gestor : resultado

    Gestor -> Bolsin : sosEnviado() : Boolean
    Bolsin -> Bolsin : obtenerEstadoActual()  : Estado
    Bolsin -> CEBolsin : sosActual() : Boolean
    'CEBolsin --> Bolsin : cambioActual
    Bolsin -> ActualCEBolsin : sosEnviado() : Boolean
    ActualCEBolsin -> Estado : esEnviado() : Boolean
    'Estado --> Bolsin : resultado
    'Bolsin --> Gestor : resultado

    Gestor -> Bolsin : getCMOrigen() : ComisionMedica
    Gestor -> CMBolsin : getNombre() : String
    'Bolsin --> Gestor : cmOrigen

    Gestor -> Bolsin : getNumeroPrecinto() : Int
    'Bolsin --> Gestor : numeroPrecinto
end

Gestor -> Pantalla : mostrarListadoBolsines(nombreCMOgigen:String, nroPrecinto:int) : void

Responsable -> Pantalla : tomarSeleccBolsin() : void
Pantalla -> Gestor : tomarSeleccBolsin() : void

' Buscar remitos y documentación del bolsín seleccionado
Gestor -> Gestor : buscarRemitosBolsin(sleccBolsin:Bolsin) : Remito[]
Gestor -> SeleccBolsin : obtenerInformacionRemito() : void
'Bolsin --> Gestor : remitos

loop Para todos los remitos del bolsín
    SeleccBolsin -> Remito : getNumero() : Int
    'Remito --> Gestor : numeroRemito

    SeleccBolsin -> Remito : getDatosDocumentacion() : String
    'Remito --> Gestor : detalles

    loop Para todos los detalles del remito
        Remito -> Detalle : getDocumentacion() : Documentacion
        'Detalle --> Gestor : documentacion

        Detalle -> Doc : getAsunto() : String
        'Doc --> Gestor : asunto

        Detalle -> Doc : getTipoDocumento() : TipoDocumento
        'Doc --> Gestor : tipoDocumento

        Doc -> TipoDoc : getNombre() : String
        'TipoDoc --> Gestor : nombreTipoDocumento
    end
end

Gestor -> Pantalla : mostrarDatosRemitos() : void
Gestor -> Pantalla : mostrarOpcRecepcionBolsin() : void

Responsable -> Pantalla : tomarSeleccOpcionRecepcion() : void
Pantalla -> Gestor : tomarSeleccOpcionRecepcion() : void

Gestor -> Pantalla : solicitarConfirmacion() : void

Responsable -> Pantalla : tomarConfirmacion() : void
Pantalla -> Gestor : tomarConfirmacion() : void

Gestor -> Gestor : recibirBolsinCMDestino() : void

' Validar que el bolsín corresponde a la recepción
Gestor -> Gestor : buscarEstadoRecibidoCMDestino() : Estado
loop Para todos los estados. Buscar estado Bolsin Recibido en CM Destino
    Gestor -> Estado : esAmbitoBolsin() : Boolean
    Gestor -> Estado : esRecibidoEnCMDestino() : Boolean

end 

Gestor -> Gestor : getFechaActual() : Datetime
'Sesion --> Gestor : fechaActual

Gestor -> Gestor : getEmpleadoLogueado() : Empleado
'Sesion --> Gestor : empleado

Gestor -> Empleado : getDatosEmpleado() : String
'Empleado --> Gestor : datosEmpleado



' Registrar recepción del bolsín
Gestor -> SeleccBolsin : recibirBolsin(estado:Estado, f:Datetime, responsable:Empleado) : void

activate SeleccBolsin

SeleccBolsin -> SeleccBolsin : obtenerEstadoActual() : Estado
SeleccBolsin -> ActualCEBolsin : setFechaHoraFin(f:Datetime) : void
SeleccBolsin -> SeleccBolsin : crearCambioDeEstado(estado:Estado, f:Datetime, responsable:Empleado) : void

create RecibidoEnCMDestino
SeleccBolsin --> RecibidoEnCMDestino : new(estado:Estado, f:Datetime, responsable:Empleado) : CambioEstadoBolsin

Gestor -> Gestor : buscarEstadoRecibidoYAceptado() : Estado
loop Para todos los estados. Buscar estado Remito Recibido y Aceptado
    Gestor -> Estado : esAmbitoRemito() : Boolean
    Gestor -> Estado : esRecibidoYAceptado() : Boolean
end

Gestor -> Gestor : buscarEstadoRecibidaYAceptada() : Estado
loop Para todos los estados. Buscar estado Documentacion Recibida y Aceptada
    Gestor -> Estado : esAmbitoDocumentacion() : Boolean
    Gestor -> Estado : esRecibidaYAceptada() : Boolean
end


Gestor -> Gestor : RecibirYAceptarRemitos(estado:Estado) : void

loop Para todos los remitos del bolsin
    Gestor -> SeleccBolsin : RecibirYAceptarRemitos(estado:Estado) : void
    SeleccBolsin -> Remito : recibirYAceptar(estado:Estado) : void
    Remito -> Remito : setEstado(estado:Estado) : void

    Gestor -> Gestor : getFechaActual() : DateTime
    Gestor -> Gestor :getEmpleadoLogueado() : Empleado
    Gestor -> Empleado : getDatosEmpleado() : String

    Gestor -> Gestor : recibirYAceptarDoc(estado:Estado, f:Datetime, responsable:Empleado) : void
    Gestor -> SeleccBolsin : recibirYAceptarDoc(estado:Estado, f:Datetime, responsable:Empleado) : void


    SeleccBolsin -> Remito : actualizarEstadoDoc(estado:Estado, f:Datetime, responsable:Empleado) : void

    ' Actualizar todos los remitos del bolsín
    loop Para todos los Documentos asociados al Remito
        
        ' Actualizar la documentación de cada remito
        Remito -> Detalle : actualizarEstadoDoc(estado:Estado, f:Datetime, responsable:Empleado) : void
        Detalle -> Doc : marcarRecibidaYAceptada(estado:Estado, f:Datetime, responsable:Empleado) : void

        activate Doc
        Doc -> Doc : getEstadoActual() : void


        Doc -> CambEstDoc : sosActual() : Boolean
        'CambEstDoc --> Doc : cambioEstadoActual

        Doc -> CambEstDoc : setFechaHoraFin(fechaActual:Datetime) : void

        create NuevoCED
        Doc --> NuevoCED : new(estado:Estado, f:Datetime, responsable:Empleado) : CambioEstadoDocumentacion

        'Estado --> Doc : estadoRecibidaAceptada

        'Doc --> Detalle : documentación actualizada

        deactivate Doc

        'Detalle --> Remito : documentación actualizada

        'Remito --> Bolsin : remito actualizado

        deactivate Remito
    end

    deactivate Bolsin
end
' Caso de uso incluido
Gestor -> Gestor : llamarACUNotificarRecepcionBolsin() : void
Gestor -> CU29 : <<include>> CU29 Notificar recepción Bolsín

Gestor -> Pantalla : mostrarNotificacionExito() : void
Gestor -> Gestor : finCU()

deactivate Gestor

@enduml
