
@startuml

scale max 3000*3000

skinparam classAttributeIconSize 0
hide empty methods
hide circle

title Diagrama de Clases - Recepción de Bolsín

'========================================
' CONFIGURACION VISUAL
'========================================



skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55

skinparam class {
    BackgroundColor #F8FAFC
    BorderColor #34495E
    FontColor #17202A
    FontName Arial
    FontSize 12
    ArrowColor #34495E
}

hide circle

'========================================
' CLASES DE USUARIO Y SESION
'========================================

class Sesion {
    - fechaHoraFinSesion: DateTime
    - fechaHoraInicioSesion: DateTime
    --
    + getFechaHoraFinSesion(): DateTime
    + getFechaHoraInicioSesion(): DateTime
    + getUsuario(): Usuario
    + setFechaHoraFinSesion(): void
    + setFechaHoraInicioSesion(): void
}

class Usuario {
    - password: string
    - user: string
    --
    + getUser(): string
    + setPassword(): void
    + setUser(): void
}

class Empleado {
    - apellido: string
    - nombre: string
    --
    + esTuUsuario(usuario:Usuario): Boolean
    + getDatosEmpleado(): String
    + getApellido(): string
    + getCM(): ComisionMedica
    + getNombre(): string
    + getNombreEmpleado(): string
    + getNombreRol(): string
    + setApellido(): void
    + setNombre(): void
}

'========================================
' UBICACION GEOGRAFICA
'========================================

class Provincia {
    - descripcion: string
    - nombre: string
    --
    + getDescripcion(): string
    + getNombre(): string
    + setDescripcion(): void
    + setNombre(): void
}

class Localidad {
    - descripcion: string
    - nombre: string
    --
    + getDescripcion(): string
    + getNombre(): string
    + setDescripcion(): void
    + setNombre(): void
}

class ComisionMedica {
    - codigo: int
    - direccion: string
    - email: string
    - nombre: string
    - telefono: string
    --
    + getNombre(): string
    + getCodigo(): int
    + getDireccion(): string
    + getEmail(): string
    + getTelefono(): string
    + setCodigo(): void
    + setDireccion(): void
    + setEmail(): void
    + setNombre(): void
    + setTelefono(): void
}

'========================================
' DOCUMENTACION
'========================================

class TipoDocumento {
    - descripcion: string
    - nombre: string
    --
    + getDescripcion(): string
    + getNombre(): string
    + new(): void
    + setDescripcion(): void
    + setNombre(): void
}

class Archivo {
    - nombreArchivo: string
    - tituloDocumento: string
    --
    + getNombreArchivo(): string
    + getTituloDocumento(): string
    + setNombreArchivo(): void
    + setTituloDocumento(): void
}

class Documentacion {
    - asunto: string
    - fechaPase: DateTime
    - numero: int
    --
    + getAsunto(): string
    + getTipoDocumento(): TipoDocumento
    + marcarRecibidaYAceptada(estado:Estado, f:Datetime, responsable:Empleado): void
    + getEstadoActual(): void
    + darDeBaja(): void
    + getEstado(): Estado
    + getFechaPase(): DateTime
    + getNumero(): int
    + marcarEnBolsinSaliente(): void
    + marcarEnBolsinEnviado(): void
    + marcarEnRemito(): void
    + marcarParaRedirigir(): void
    + marcarRecibidaRechazada(): void
    + marcarNoRecibida(): void
    + reenviar(): void
    + quitarDeBolsin(): void
    + quitarDeRemito(): void
    + registrar(): void
    + remitar(): void
    + setEstado(): void
    + setFechaPase(): void
    + setNumero(): void
}

class CambioEstadoDocumentacion {
    - fechaHoraFin: DateTime
    - fechaHoraInicio: DateTime
    - respondable: Empleado
    --
    + getFechaHoraFin(): DateTime
    + getFechaHoraInicio(): DateTime
    + setFechaHoraFin(fechaFin:Datetime): void
    + setFechaHoraInicio(fechaInicio:Datetime): void
    + sosActual(): Boolean
    + new(estado:Estado, f:Datetime, responsable:Empleado): CambioEstadoDocumentacion
}

'========================================
' ESTADOS
'========================================

class Estado {
    - ambito: string
    - descripcion: string
    - nombre: string
    --
    + esAmbitoBolsin(): Boolean
    + esAmbitoDocumentacion(): Boolean
    + esAmbitoRemito(): Boolean
    + esEnviado(): Boolean
    + esRecibidaYAceptada(): Boolean
    + esRecibidoEnCMDestino(): Boolean
    + esRecibidoYAceptado(): Boolean
    + getAmbito(): string
    + getDescripcion(): string
    + getNombre(): string
    + new(): void
    + setAmbito(): void
    + setDescripcion(): void
    + setNombre(): void
}

'========================================
' REMITOS
'========================================

class Remito {
    - fecha: DateTime
    - numero: int
    --
    + getNumero(): int
    + getDatosDocumentacion(): string
    + recibirYAceptar(estado:Estado): void
    + setEstado(estado:Estado): void
    + actualizarEstadoDoc(estado:Estado, f:Datetime, responsable:String): void
    + estasGenerado(): Boolean
    + getDatosRemito(): void
    + getFecha(): DateTime
    + modificarDocumentacionIncluida(): void
    + new(): void
    + setEstado(): void
    + setFecha(): void
    + setNumero(): void
    + tenesEstaCMDestino(): Boolean
    + tenesEstaCMOrigen(): Boolean
    + tomarDocumentacion(): void
}

class DetalleDeRemito {
    - areaCMDestino: int
    --
    + aceptarDocumentacion(): void
    + actualizarEstadoDoc(estado:Estado, f:Datetime, responsable:String) : void
    + getDocumentacion(): Documentacion
    + setAreaCMDestino(): void
}

'========================================
' BOLSINES
'========================================

class Bolsin {
    - fecha: DateTime
    - numeroBolsin: int
    - numeroPrecinto: int
    - peso: double
    --
    + esTuCMDestino(cm:ComisionMedica) : Boolean
    + sosEnviado(): Boolean
    + obtenerEstadoActual(): Estado
    + getCMOrigen(): ComisionMedica
    + getNumeroPrecinto(): int
    + obtenerInformacionRemito(): void
    + recibirBolsin(estado:Estado, f:Datetime, responsable:String): void
    + obtenerEstadoActual(): Estado
    + crearCambioDeEstado(estado:Estado, f:Datetime, responsable:String): void
    + RecibirYAceptarRemitos(estado:Estado): void
    + recibirYAceptarDoc(estado:Estado, f:Datetime, responsable:String) : void
    
}

class CambioEstadoBolsin {
    - fechaHoraFin: DateTime
    - fechaHoraInicio: DateTime
    - estado: Estado
    - respondable: Empleado
    --
    + getFechaHoraFin(): DateTime
    + getFechaHoraInicio(): DateTime
    + setFechaHoraFin(fechaHoraFin: DateTime): void
    + setFechaHoraInicio(fechaHoraInicio: DateTime): void
    + sosActual(): Boolean
    + sosEnviado(): Boolean
    + new(estado:Estado, f:Datetime, responsable:Empleado)
}

'========================================
' GESTOR
'========================================

class GestorRecepcionBolsin {
    - cambioEstadoBolsin: CambioEstadoBolsin
    - cambioEstadoDocumentacion: CambioEstadoDocumentacion
    - detalleRemito: DetalleDeRemito
    - documentacion: Documentacion
    - empleado: Empleado[]
    - estado: Estado[]
    - remito: Remito[]
    - sesion: Sesion
    - usuario: Usuario
    - nombreCM: String
    - fechaActual: Datetime
    - cm: ComisionMedica
    - nroPrecinto: Int
    - seleccBolsin: Bolsin
    - empleadoLogueado: Empleado
    - recibidoEnCMDestino: Estado
    - recibidaYAceptada: Estado
    - recibidoYAceptado: Estado
    
    --
    + opcregistrarRecepcionBolsin() : void
    + getEmpleadoLogueado(): Empleado
    + buscarBolsinesEnviados() : Bolsin[]
    + tomarSeleccBolsin() : void
    + buscarRemitosBolsin(sleccBolsin:Bolsin) : Remito[]
    + tomarSeleccOpcionRecepcion() : void
    + tomarConfirmacion(): void
    + recibirBolsinCMDestino(): void
    + buscarEstadoRecibidoCMDestino() : Estado
    + getFechaActual(): DateTime
    + buscarEstadoRecibidoYAceptado() : Estado
    + buscarEstadoRecibidaYAceptada() : Estado
    + RecibirYAceptarRemitos(estado:Estado) : void
    + recibirYAceptarDoc(estado:Estado, f:Datetime, responsable:String) : void
    + llamarACUNotificarRecepcionBolsin() : void
    + finCU(): void
    
}

'========================================
' INTERFAZ
'========================================

class PantallaRecepcionBolsin {
    + opcregistrarRecepcionBolsin() : void
    + mostrarCM(nombreCM:String) : void
    + mostrarListadoBolsines(nombreCMOgigen:String, nroPrecinto:int) : void
    + habilitarPantalla(): void
    + mostrarOpcRecepcionBolsin(): void
    + mostrarNotificacionExito() : void
    + mostrarDatosRemitos(): void
    + tomarSeleccBolsin(): void
    + tomarSeleccionOpcionRecepcion(): void
    + tomarConfirmacion(): void
    + solicitarConfirmacion(): void
}

'========================================
' RELACIONES
'========================================

' Sesion y usuario

Sesion --> "1" Usuario : usuario


' Ubicacion

Provincia "1" <-- Localidad : provincia
Localidad "1" <-- ComisionMedica : localidad

' Empleado 

Empleado --> "1" ComisionMedica : asignadoA
Empleado --> "1" Usuario : usuario

' Documentacion

Documentacion --> "1" TipoDocumento : tipoDocumento
Documentacion --> "1..*" Archivo : archivoAdjunto
Documentacion --> "1" ComisionMedica : cmOrigen
Documentacion --> "1..*" CambioEstadoDocumentacion : cambiosEstado

CambioEstadoDocumentacion --> "1" Estado : estado
CambioEstadoDocumentacion --> "1" Empleado : responsableCE

' Remitos

Remito *-- "1..*" DetalleDeRemito : detalleRemito
DetalleDeRemito --> "1" Documentacion : documentacion

Remito --> "1" Estado : estado
Remito --> "1" ComisionMedica : origen
Remito --> "1" ComisionMedica : destino

' Bolsines

Bolsin *-- "1..*" Remito : remitos
Bolsin --> "1" ComisionMedica : origen
Bolsin --> "1" ComisionMedica : destino
Bolsin --> "1..*" CambioEstadoBolsin : cambiosEstado

CambioEstadoBolsin --> "1" Estado : estado
CambioEstadoBolsin --> "1" Empleado : responsableCE

' Gestor y entidades utilizadas. DEPENDENCIAS

GestorRecepcionBolsin ..> Sesion
GestorRecepcionBolsin ..> Empleado
GestorRecepcionBolsin ..> Bolsin
GestorRecepcionBolsin ..> Remito
GestorRecepcionBolsin ..> DetalleDeRemito
GestorRecepcionBolsin ..> Documentacion
GestorRecepcionBolsin ..> Estado
GestorRecepcionBolsin ..> CambioEstadoBolsin
GestorRecepcionBolsin ..> CambioEstadoDocumentacion
GestorRecepcionBolsin ..> ComisionMedica
GestorRecepcionBolsin ..> PantallaRecepcionBolsin

' Interfaz y gestor

PantallaRecepcionBolsin ..> GestorRecepcionBolsin

@enduml
